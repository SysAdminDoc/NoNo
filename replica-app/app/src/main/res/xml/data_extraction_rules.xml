<?xml version="1.0" encoding="utf-8"?>
<!--
    Applies to Android 12 (API 31) and newer.

    This app reads other apps' notifications, so anything it stores is derived from that
    content. None of it leaves the device through an automatic transfer: cloud backup and
    device-to-device transfer both exclude the preference store and the listener's own
    scratch state. Rules move between devices only through an explicit, user-initiated
    export.

    Which entry does the work differs by file, and it is worth being exact about it. The
    preference store, the history database and the pseudonym key live under noBackupFilesDir,
    which the platform excludes by itself, so for those the entries below are a second line of
    defence. The database entry is currently inert: Room opens the file by absolute path inside
    the no-backup directory, so nothing is ever written to the standard database location this
    names. It is kept so the rule is already in place if that file ever moves. The listener's
    scratch preferences are the exception. They are ordinary shared preferences in the backed-up
    tree, and these entries are the only thing keeping them out of a transfer. Verified on device
    with a bmgr backup and restore cycle on 2026-08-31.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
        <exclude domain="database" path="nono_history.db" />
        <exclude domain="sharedpref" path="runtime_history.xml" />
        <exclude domain="sharedpref" path="capture_gate.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="database" path="nono_history.db" />
        <exclude domain="sharedpref" path="runtime_history.xml" />
        <exclude domain="sharedpref" path="capture_gate.xml" />
    </device-transfer>
</data-extraction-rules>
