<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NoNo" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <!--
            System bar colours are no-ops from API 35 and are owned by enableEdgeToEdge in
            MainActivity, which is the only thing that still has an effect at targetSdk 36.
        -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
