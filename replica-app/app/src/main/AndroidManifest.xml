<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Package visibility for the app picker and for opening the app a history record came from.
        Android 11 and newer hide other packages by default: getLaunchIntentForPackage returns null
        and queryIntentActivities returns nothing for anything not visible. This declares the
        narrow shape actually needed, a launchable activity, rather than QUERY_ALL_PACKAGES, which
        is a policy-restricted permission. This app declares no permissions at all.

        Apps with no launcher activity stay invisible to this query. The picker covers them from
        notification history instead, which needs no visibility at all.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="NoNo"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.NoNo">
        <!--
            No screenOrientation lock: targetSdk 36 ignores it on displays >= 600dp anyway,
            and the temporary opt-out property stops working at API 37.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".runtime.SignalNotificationListener"
            android:exported="false"
            android:label="NoNo notification access"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing|silent" />
        </service>
        <service
            android:name=".runtime.SignalCapturePauseTileService"
            android:exported="true"
            android:label="Pause notification capture"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver
            android:name=".runtime.SignalWidgetProvider"
            android:exported="true"
            android:label="NoNo metadata">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/signal_widget_info" />
        </receiver>
    </application>
</manifest>
