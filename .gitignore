# Android/Gradle build products and machine-local configuration
.gradle/
**/build/
local.properties
.idea/
*.iml

# Build artifacts are published as release assets, not tracked blobs.
# SHA256SUMS.txt stays tracked so a downloaded artifact can still be verified.
replica-app/dist/*.apk

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
.kotlin/

# Working notes and agent scaffolding. README.md and CHANGELOG.md are tracked;
# every other markdown file at the root is local-only.
/CLAUDE.md
/AGENTS.md
/RESEARCH.md
/ROADMAP.md
/Roadmap_Blocked.md
/CODEX_CHANGELOG.md
.claude/

